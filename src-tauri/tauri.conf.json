{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Carbon",
  "version": "0.1.11",
  "identifier": "com.carbon.clipboard",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:3210",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Carbon — Clipboard Manager",
        "width": 1240,
        "height": 740,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "decorations": false,
        "shadow": true,
        "center": true,
        "visible": false,
        "focus": false,
        "backgroundThrottling": "disabled",
        "dragDropEnabled": false
      },
      {
        "label": "overlay",
        "title": "Carbon Quick Paste",
        "width": 680,
        "height": 440,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": true,
        "visible": false,
        "focus": false,
        "transparent": true,
        "backgroundThrottling": "disabled",
        "dragDropEnabled": false
      },
      {
        "label": "pill",
        "title": "Carbon Pill",
        "width": 360,
        "height": 72,
        "resizable": false,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "transparent": true,
        "backgroundThrottling": "disabled",
        "dragDropEnabled": false
      },
      {
        "label": "argprompt",
        "title": "Carbon Prompt",
        "width": 480,
        "height": 220,
        "resizable": false,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "center": true,
        "focus": false,
        "transparent": true,
        "backgroundThrottling": "disabled",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "binaries/tesseract": "tesseract"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERGQUYyN0JFQTA2QTNCM0MKUldROE8ycWd2aWV2M3hVMjhkdXY4UE9uVnRsM2k1SEtKNGx6YlhhT0UwdFJBVHVvTkREYnZkbEkK",
      "endpoints": [
        "https://github.com/sanirudh17/Carbon/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
